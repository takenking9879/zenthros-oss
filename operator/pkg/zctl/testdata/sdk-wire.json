    {
      "case": "the job is gone",
      "means": "job-absent",
      "args": [
        "get",
        "zenthrosjob",
        "-o",
        "json",
        "train"
      ],
      "code": 66,
      "stderr": "zctl: zenthrosjob \"train\" not found\n"
    },
    {
      "case": "the Workspace is not one the hub routes",
      "means": "invalid",
      "args": [
        "get",
        "zenthrosjob",
        "-o",
        "json",
        "train"
      ],
      "code": 64,
      "stderr": "zctl: get zenthrosjob: Workspace risk not found\n"
    },
    {
