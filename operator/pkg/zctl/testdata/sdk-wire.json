    {
      "case": "a create with no answer",
      "means": "unknown",
      "args": [
        "create",
        "zenthrosjob",
        "-f",
        "job.json",
        "--workspace",
        "risk"
      ],
      "code": 1,
      "stderr": "zctl: create zenthrosjob /j: an error on the server (\"upstream connect error\") has prevented the request from succeeding\n"
